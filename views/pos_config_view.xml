<odoo>
    <record id="pos_config_view_form_inherit_add_salesperson" model="ir.ui.view">
        <field name="name">pos.config.view.form.inherit.add.salesperson</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='title']" position="after">
                <group>
                    <field name="salesperson_ids" widget="many2many_tags"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>