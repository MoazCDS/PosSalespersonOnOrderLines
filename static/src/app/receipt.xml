<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="cds_pos_salesperson.receiptRemoveDecimals"
        t-inherit="point_of_sale.OrderReceipt"
        t-inherit-mode="extension"
        owl="1">
        <xpath expr="//span[@t-esc='props.formatCurrency(props.data.amount_total)']" position="replace">
            <span t-esc="Math.ceil(props.data.amount_total)" class="pos-receipt-right-align"/>
        </xpath>

        <xpath expr="//span[@t-esc='props.formatCurrency(line.amount, false)']" position="replace">
            <span t-esc="Math.ceil(line.amount)" class="pos-receipt-right-align"/>
        </xpath>

        <xpath expr="//span[@t-esc='props.formatCurrency(props.data.change)']" position="replace">
            <span t-esc="Math.ceil(props.data.change)" class="pos-receipt-right-align"/>
        </xpath>

        <xpath expr="//span[@t-esc='props.formatCurrency(tax.amount, false)']" position="replace">
            <span t-esc="Math.ceil(tax.amount)" />
        </xpath>

        <xpath expr="//span[@t-esc='props.formatCurrency(tax.base, false)']" position="replace">
            <span t-esc="Math.ceil(tax.base)" />
        </xpath>

        <xpath expr="//span[@t-esc='props.formatCurrency(tax.amount + tax.base, false)']" position="replace">
            <span t-esc="Math.ceil(tax.amount + tax.base)" />
        </xpath>

        <xpath expr="//div[@class='pos-receipt']" position="inside">
            <div t-if="props.data.qrcode">
                <br /><br />
                <div class="pos-receipt-order-data mb-2">
                    Scan for more information
                </div>
                <img t-attf-src="/report/barcode/QR/{{props.data.qrcode}}?&amp;width=100&amp;height=100&amp;quiet=0"
                    width="100" height="100" alt="QR Code"/>
            </div>
        </xpath>
    </t>
</templates>